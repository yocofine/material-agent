# 生产模板；复制为 .env.production 后填写真实值，禁止在本文件保存真实凭据。
DOMAIN=upload.example.com
PUBLIC_BASE_URL=https://upload.example.com

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
LINK_SIGNING_SECRET=replace-with-at-least-32-random-bytes
STAFF_SESSION_HOURS=12
# CRM 对接契约默认不鉴权；只有双方另行约定 Bearer Token 时才填写。
TASK_API_TOKEN=
TASK_DOWNLOAD_TIMEOUT=120
TASK_DOWNLOAD_CONCURRENCY=3
TASK_WORKER_CONCURRENCY=3
TASK_CLASSIFICATION_CONCURRENCY=5
TASK_ALLOW_PRIVATE_URLS=false

QWEN_API_KEY=replace-with-your-api-key
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TIMEOUT=60
EXTRACT_TIMEOUT=60
CLASSIFICATION_SNIPPET_CHARS=4000
API_MAX_FILE_MB=1024
API_MAX_ARCHIVE_MB=300
API_MAX_EXTRACTED_MB=600
API_MAX_EXTRACTED_FILES=199

DATABASE_URL=sqlite:////app/data/material_agent.db
WORKSPACE_DIR=/app/data/workspace
INBOX_DIR=/app/data/inbox
ORGANIZED_DIR=/app/data/organized

# 正式客户—教辅关系（只读 MySQL）
CUSTOMER_DB_HOST=
CUSTOMER_DB_PORT=3306
CUSTOMER_DB_NAME=
CUSTOMER_DB_USER=
CUSTOMER_DB_PASSWORD=
CUSTOMER_DB_TABLE=
CUSTOMER_ID_COLUMN=
CUSTOMER_NAME_COLUMN=
STAFF_USERNAME_COLUMN=

ORDER_API_BASE_URL=
ORDER_API_TOKEN=
